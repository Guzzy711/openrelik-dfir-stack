    {"category": ["email"], "any": ["mail", "outlook"]},
    {"category": ["package"], "any": [
      "package", ":apt", "dpkg", "rpm", "yum", "installed", "applications", "appstore",
      "programs", "uninstall"
    ]},
    {"category": ["iam"], "any": ["users", "accounts", "groups", "passwd", "shadow", ":sam"]},
