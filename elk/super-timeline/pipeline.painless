// Super timeline: fills the ECS fields every tool shares, so one Kibana data view can show
// all timelines with the same columns: @timestamp, host.name, event.category, event.action,
// message. Handles both shapes the workers write (Timesketch JSONL with data_type, and
// Elasticsearch bulk NDJSON with event.module/event.dataset and the tool's fields under
// <module>) and Plaso's psort json_line.
//
// Also artifact.name and artifact.description: what the artifact is and what it tells an
// investigator.
//
// The tables are the script's params: params.rules (rules.json: categories, labels) and
// params.descriptions (descriptions.json). elk/configure.sh installs the pipeline.

String text(def value) {
  if (value == null) { return null; }
  if (value instanceof List) { return ((List) value).isEmpty() ? null : text(((List) value).get(0)); }
  String s = value.toString().trim();
  return s.isEmpty() || s == '-' ? null : s;
}

// The first of the fields with a value, at the top level or under the tool's namespace.
String pick(Map doc, Map tool, List names) {
  for (String name : names) {
    String value = text(doc.get(name));
    if (value == null && tool != null) { value = text(tool.get(name)); }
    if (value != null) { return value; }
  }
  return null;
}

boolean has(String haystack, List needles) {
  for (String needle : needles) {
    if (haystack.contains(needle)) { return true; }
  }
  return false;
}

boolean isHex(String value) {
  for (int i = 0; i < value.length(); i++) {
    char c = value.charAt(i);
    if (!((c >= (char) 48 && c <= (char) 57) || (c >= (char) 97 && c <= (char) 102))) { return false; }
  }
  return value.length() > 0;
}

// The map at ctx[group] (file, process, dll), made if missing.
Map group(Map doc, String name) {
  if (!(doc.get(name) instanceof Map)) { doc.put(name, new HashMap()); }
  return (Map) doc.get(name);
}

// ECS hash fields: <group>.hash.<algo>, lowercase.
void putHash(Map doc, String name, String algo, String value) {
  if (value == null) { return; }
  value = value.trim().toLowerCase();
  if (algo == 'imphash') {
    if (isHex(value)) { group(group(doc, name), 'pe').put('imphash', value); }
    return;
  }
  if (algo != 'ssdeep' && algo != 'tlsh' && !isHex(value)) { return; }
  Map g = group(doc, name);
  if (!(g.get('hash') instanceof Map)) { g.put('hash', new HashMap()); }
  ((Map) g.get('hash')).put(algo, value);
}

// A dotted ECS field (url.original) set to value, unless it has one already.
void putField(Map doc, String path, def value) {
  if (value == null) { return; }
  String[] parts = path.splitOnToken('.');
  Map m = doc;
  for (int i = 0; i < parts.length - 1; i++) { m = group(m, parts[i]); }
  if (m.get(parts[parts.length - 1]) == null) { m.put(parts[parts.length - 1], value); }
}

// The first value among the names in each of the maps.
String pickAny(List maps, List names) {
  for (String name : names) {
    for (def m : maps) {
      if (m instanceof Map) {
        String value = text(((Map) m).get(name));
        if (value != null) { return value; }
      }
    }
  }
  return null;
}

Map event = ctx.event instanceof Map ? ctx.event : new HashMap();
String module = text(event.module);
String dataset = text(event.dataset);

// The artifact key, tool:artifact, such as dissect:prefetch or windows:evtx:record.
String key = text(ctx.data_type);
if (key == null && dataset != null) {
  if (module != null && dataset.startsWith(module + '.')) {
    key = module + ':' + dataset.substring(module.length() + 1);
  } else if (module != null && !dataset.startsWith(module + ':')) {
    key = module + ':' + dataset;
  } else {
    key = dataset;
  }
}
if (key == null) { key = module != null ? module : 'unknown'; }
String lower = key.toLowerCase();
int colon = lower.indexOf(':');
String tool = colon > 0 ? lower.substring(0, colon) : lower;
if (module == null) { module = ctx.containsKey('parser') && ctx.containsKey('date_time') ? 'plaso' : tool; }
Map fields = ctx.get(module) instanceof Map ? (Map) ctx.get(module) : null;

// Tool fields named like an ECS object (Dissect's url, user, source, server) as text: to
// their ECS field, else under the tool's namespace, so the ECS objects can exist.
for (String name : params.rules.ecs_objects) {
  def value = ctx.get(name);
  if (value == null || value instanceof Map) { continue; }
  ctx.remove(name);
  String target = params.rules.ecs_moves.get(name);
  String asText = text(value);
  if (name == 'source' && asText != null && (asText.contains('/') || asText.contains('\\')) && !asText.startsWith('$(')) {
    target = 'log.file.path';
  }
  if (target != null) { putField(ctx, target, value); } else { putField(ctx, module + '.' + name, value); }
}

// event.dataset as ECS recommends, module.dataset (dissect.browser.history); the
// tool:artifact key stays in data_type, as the workers write it.
if (ctx.data_type == null) { ctx.data_type = key; }
String datasetName = colon > 0 && lower.substring(0, colon) == module ? key.substring(colon + 1) : key;
event.dataset = colon < 0 && key == module ? module : module + '.' + datasetName.replace(':', '.');
event.module = module;

// @timestamp: Timesketch datetime, else Plaso's timestamp in microseconds.
if (ctx['@timestamp'] == null) {
  String datetime = text(ctx.datetime);
  if (datetime != null) {
    ctx['@timestamp'] = datetime;
  } else if (ctx.timestamp instanceof Number) {
    long micros = ((Number) ctx.timestamp).longValue();
    long seconds = micros / 1000000L;
    long rest = micros % 1000000L;
    if (rest < 0) { seconds -= 1; rest += 1000000L; }
    ctx['@timestamp'] = Instant.ofEpochSecond(seconds, rest * 1000L).toString();
  }
}

// host.name
Map host = ctx.host instanceof Map ? ctx.host : new HashMap();
if (text(host.name) == null) {
  String name = pick(ctx, fields, params.rules.host_fields);
  if (name != null) { host.name = name; ctx.host = host; }
}

// What the timestamp means: the Timesketch field, else the bulk format's event.action
// (kept in timestamp_desc so the pipeline can run on its own output again).
String desc = text(ctx.timestamp_desc);
if (desc == null && !ctx.containsKey('super_timeline_version')) { desc = text(event.action); }
if (desc != null) { ctx.timestamp_desc = desc; }
if (desc != null && params.rules.time_labels.containsKey(desc)) { desc = params.rules.time_labels.get(desc); }

// The artifact as people say it: LEAPP's artifact name, the last part of UAC's artifact
// path (live_response/system/lastlog: lastlog), else the key without the tool. Categories
// match on the whole artifact.
// artifact is a name in the workers' output and an object (name, description) after this
// pipeline ran.
String artifact = null;
if (ctx.artifact instanceof Map) {
  artifact = text(((Map) ctx.artifact).get('name'));
} else {
  artifact = pick(ctx, fields, ['artifact']);
}
String label;
if (artifact != null) {
  int slash = artifact.lastIndexOf('/');
  label = slash >= 0 ? artifact.substring(slash + 1).replace('_', ' ') : artifact;
} else {
  label = colon > 0 && tool != 'windows' && module != 'plaso' ? key.substring(colon + 1) : key;
  label = label.replace(':', ' ').replace('.', ' ').replace('_', ' ');
}

List category = new ArrayList();
String kind = 'event';
String eventId = pick(ctx, fields, ['EventID', 'event_identifier', 'event_id']);
String channel = pick(ctx, fields, ['Channel', 'channel']);

if (tool == 'hayabusa') {
  kind = 'alert';
  category.add('intrusion_detection');
  String rule = pick(ctx, fields, ['rule_title', 'RuleTitle']);
  event.action = rule != null ? rule : 'Hayabusa detection';
  String level = pick(ctx, fields, ['level', 'Level']);
  if (level != null && params.rules.severity.containsKey(level.toLowerCase())) {
    event.severity = params.rules.severity.get(level.toLowerCase());
  }
} else if (eventId != null && (lower.contains('evtx') || lower.contains('eventlog'))) {
  event.action = label + ': EventID ' + eventId;
  if (channel != null && channel.toLowerCase().contains('sysmon') && params.rules.sysmon_ids.containsKey(eventId)) {
    category.addAll(params.rules.sysmon_ids.get(eventId));
  } else if (params.rules.event_ids.containsKey(eventId)) {
    category.addAll(params.rules.event_ids.get(eventId));
  }
} else {
  event.action = desc != null ? label + ': ' + desc : label;
}

// Categories by keyword in the artifact key (and LEAPP's artifact name): first rule wins.
if (category.isEmpty()) {
  String haystack = lower + ' ' + (artifact != null ? artifact : label).toLowerCase();
  for (Map rule : params.rules.rules) {
    if (has(haystack, rule.any)) { category.addAll(rule.category); break; }
  }
}
if (!category.isEmpty()) { event.category = category; }

// ECS fields from the tools' own: event code and provider, rule, user, IPs and ports,
// process, URL. Hayabusa keeps its fields in details and extra.
Map extra = ctx.extra instanceof Map ? (Map) ctx.extra : (fields != null && fields.extra instanceof Map ? (Map) fields.extra : null);
Map hayabusaDetails = ctx.details instanceof Map ? (Map) ctx.details : (fields != null && fields.details instanceof Map ? (Map) fields.details : null);
List maps = [ctx, fields, hayabusaDetails, extra];
if (eventId != null) { event.code = eventId; }
String provider = pickAny(maps, ['Provider_Name', 'source_name', 'provider']);
if (provider != null) { event.provider = provider; }
if (tool == 'hayabusa') {
  putField(ctx, 'rule.name', pickAny(maps, ['rule_title', 'RuleTitle']));
  putField(ctx, 'rule.id', pickAny(maps, ['rule_id', 'RuleID']));
  putField(ctx, 'rule.ruleset', 'hayabusa');
}
for (Map field : params.rules.ecs_fields) {
  putField(ctx, field.ecs, pickAny(maps, field.from));
}

// Hashes, as ECS: file.hash.*, or process.hash.* / dll.hash.* for Sysmon's process
// creation and image load events. Algorithm from the field name, or the length.
Map hashLengths = ['32': 'md5', '40': 'sha1', '64': 'sha256', '96': 'sha384', '128': 'sha512'];
for (String algo : ['md5', 'sha1', 'sha256', 'sha384', 'sha512', 'ssdeep', 'tlsh']) {
  putHash(ctx, 'file', algo, pick(ctx, fields, [algo, algo.toUpperCase(), algo + '_hash']));
}
String plainHash = pick(ctx, fields, ['hash']);
if (plainHash != null && hashLengths.containsKey(String.valueOf(plainHash.trim().length())) && isHex(plainHash.trim().toLowerCase())) {
  putHash(ctx, 'file', hashLengths.get(String.valueOf(plainHash.trim().length())), plainHash);
  String path = pick(ctx, fields, ['path']);
  if (path != null && !(group(ctx, 'file').containsKey('path'))) { group(ctx, 'file').put('path', path); }
}
// Sysmon: Hashes is "SHA1=...,MD5=...,SHA256=...,IMPHASH=...", at the top (Dissect), or in
// Hayabusa's details.
Map details = ctx.details instanceof Map ? (Map) ctx.details : (fields != null && fields.details instanceof Map ? (Map) fields.details : null);
String hashes = pick(ctx, fields, ['Hashes', 'hashes']);
if (hashes == null && details != null) { hashes = text(details.get('Hashes')); }
if (hashes != null && hashes.contains('=')) {
  String target = eventId == '1' ? 'process' : (eventId == '7' ? 'dll' : 'file');
  for (String pair : hashes.splitOnToken(',')) {
    int eq = pair.indexOf('=');
    if (eq > 0) { putHash(ctx, target, pair.substring(0, eq).trim().toLowerCase(), pair.substring(eq + 1)); }
  }
}

// artifact.description: the event's own (EventID), else the first artifact rule matching.
String description = null;
if (eventId != null && (lower.contains('evtx') || lower.contains('eventlog'))) {
  Map ids = channel != null && channel.toLowerCase().contains('sysmon') ? params.descriptions.sysmon_ids : params.descriptions.event_ids;
  description = ids.containsKey(eventId) ? 'EventID ' + eventId + ': ' + ids.get(eventId) : params.descriptions.evtx;
}
if (description == null) {
  String haystack = lower + ' ' + (artifact != null ? artifact : label).toLowerCase();
  for (Map rule : params.descriptions.artifacts) {
    if (has(haystack, rule.any)) { description = rule.description; break; }
  }
}
Map artifactField = new HashMap();
artifactField.name = artifact != null ? artifact : label;
if (description != null) { artifactField.description = description; }
ctx.artifact = artifactField;
event.kind = kind;
ctx.event = event;
putField(ctx, 'ecs.version', params.rules.ecs_version);
ctx.super_timeline_version = params.rules.version;
